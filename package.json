{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "simplenote",
  "title": "Simple Note",
  "description": "Very simple local key value note.",
  "icon": "extension_icon_1.png",
  "author": "hugejile_wang",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Simple Note - List",
      "description": "Show note list",
      "mode": "view"
    },
    {
      "name": "edit",
      "title": "Simple Note - Create",
      "description": "Create a Note",
      "mode": "view"
    },
    {
      "name": "configs",
      "title": "Simple Note - Config",
      "description": "Config Simple Note",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.7.3",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "react": "19.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
